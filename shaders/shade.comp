#version 450

layout(local_size_x = 8, local_size_y = 8) in;

// Output image
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outputImage;

// Visibility buffer (R32_UINT)
layout(set = 0, binding = 1) uniform usampler2D visBuffer;

// Depth buffer for reconstruction
layout(set = 0, binding = 2) uniform sampler2D depthBuffer;

// Camera data
layout(set = 0, binding = 3) uniform CameraData {
    mat4 model;
    mat4 view;
    mat4 projection;
    mat4 invViewProj;
    vec3 cameraPos;
    float padding;
} camera;

// Vertex buffer (as storage)
struct Vertex {
    vec3 position;
    float pad0;
    vec3 normal;
    float pad1;
    vec2 uv;
    vec2 pad2;
};
layout(std430, set = 0, binding = 4) readonly buffer VertexBuffer {
    Vertex vertices[];
};

// Index buffer
layout(std430, set = 0, binding = 5) readonly buffer IndexBuffer {
    uint indices[];
};

// Draw info
struct DrawInfo {
    uint firstIndex;
    uint indexCount;
    int vertexOffset;
    int materialIndex;
};
layout(std430, set = 0, binding = 6) readonly buffer DrawBuffer {
    DrawInfo draws[];
};

// Material data
struct Material {
    vec4 baseColorFactor;
    float metallicFactor;
    float roughnessFactor;
    int albedoIndex;
    int metallicRoughnessIndex;
    int normalIndex;
    int aoIndex;
    float alphaCutoff;
    float padding;
};
layout(std430, set = 0, binding = 7) readonly buffer MaterialBuffer {
    Material materials[];
};

// Textures
layout(set = 1, binding = 0) uniform sampler2D textures[32];

// Compute barycentric coordinates from screen position and triangle
vec3 computeBarycentrics(vec2 screenPos, vec3 p0, vec3 p1, vec3 p2) {
    // Project triangle vertices to screen space
    vec4 clip0 = camera.projection * camera.view * camera.model * vec4(p0, 1.0);
    vec4 clip1 = camera.projection * camera.view * camera.model * vec4(p1, 1.0);
    vec4 clip2 = camera.projection * camera.view * camera.model * vec4(p2, 1.0);
    
    vec2 s0 = (clip0.xy / clip0.w) * 0.5 + 0.5;
    vec2 s1 = (clip1.xy / clip1.w) * 0.5 + 0.5;
    vec2 s2 = (clip2.xy / clip2.w) * 0.5 + 0.5;
    
    // Compute barycentric with edge functions
    vec2 v0 = s1 - s0;
    vec2 v1 = s2 - s0;
    vec2 v2 = screenPos - s0;
    
    float d00 = dot(v0, v0);
    float d01 = dot(v0, v1);
    float d11 = dot(v1, v1);
    float d20 = dot(v2, v0);
    float d21 = dot(v2, v1);
    
    float denom = d00 * d11 - d01 * d01;
    if (abs(denom) < 1e-10) return vec3(1.0, 0.0, 0.0);
    
    float v = (d11 * d20 - d01 * d21) / denom;
    float w = (d00 * d21 - d01 * d20) / denom;
    float u = 1.0 - v - w;
    
    return vec3(u, v, w);
}

// GGX/Trowbridge-Reitz NDF
float distributionGGX(vec3 N, vec3 H, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    
    float denom = NdotH2 * (a2 - 1.0) + 1.0;
    return a2 / (3.14159265 * denom * denom);
}

// Schlick-GGX Geometry
float geometrySchlickGGX(float NdotV, float roughness) {
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / (NdotV * (1.0 - k) + k);
}

float geometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    return geometrySchlickGGX(NdotV, roughness) * geometrySchlickGGX(NdotL, roughness);
}

// Fresnel-Schlick
vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputImage);
    
    if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y) {
        return;
    }
    
    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(imageSize);
    
    // Sample visibility buffer
    uint visData = texture(visBuffer, uv).r;
    
    if (visData == 0u) {
        // Background - dark gray
        imageStore(outputImage, pixelCoord, vec4(0.02, 0.02, 0.02, 1.0));
        return;
    }
    
    // Decode visibility
    uint drawID = visData >> 20;
    uint triangleID = visData & 0xFFFFFu;
    
    // Get draw info
    DrawInfo draw = draws[drawID];
    
    // Get triangle indices
    uint baseIdx = draw.firstIndex + triangleID * 3;
    uint i0 = indices[baseIdx + 0] + uint(draw.vertexOffset);
    uint i1 = indices[baseIdx + 1] + uint(draw.vertexOffset);
    uint i2 = indices[baseIdx + 2] + uint(draw.vertexOffset);
    
    // Get vertices
    Vertex v0 = vertices[i0];
    Vertex v1 = vertices[i1];
    Vertex v2 = vertices[i2];
    
    // Compute barycentrics
    vec3 bary = computeBarycentrics(uv, v0.position, v1.position, v2.position);
    
    // Interpolate attributes
    vec3 worldPos = bary.x * v0.position + bary.y * v1.position + bary.z * v2.position;
    worldPos = (camera.model * vec4(worldPos, 1.0)).xyz;
    
    vec3 normal = normalize(bary.x * v0.normal + bary.y * v1.normal + bary.z * v2.normal);
    normal = normalize(mat3(camera.model) * normal);
    
    vec2 texCoord = bary.x * v0.uv + bary.y * v1.uv + bary.z * v2.uv;
    
    // Get material
    Material mat = materials[draw.materialIndex];
    
    // Sample textures
    vec4 albedo = mat.baseColorFactor;
    if (mat.albedoIndex >= 0 && mat.albedoIndex < 32) {
        albedo *= texture(textures[mat.albedoIndex], texCoord);
    }
    
    float metallic = mat.metallicFactor;
    float roughness = mat.roughnessFactor;
    if (mat.metallicRoughnessIndex >= 0 && mat.metallicRoughnessIndex < 32) {
        vec4 mr = texture(textures[mat.metallicRoughnessIndex], texCoord);
        metallic *= mr.b;
        roughness *= mr.g;
    }
    
    // PBR shading
    vec3 N = normal;
    vec3 V = normalize(camera.cameraPos - worldPos);
    
    // Light direction (directional light)
    vec3 L = normalize(vec3(0.5, 1.0, 0.3));
    vec3 H = normalize(V + L);
    
    // Cook-Torrance BRDF
    vec3 F0 = mix(vec3(0.04), albedo.rgb, metallic);
    
    float NDF = distributionGGX(N, H, roughness);
    float G = geometrySmith(N, V, L, roughness);
    vec3 F = fresnelSchlick(max(dot(H, V), 0.0), F0);
    
    vec3 numerator = NDF * G * F;
    float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) + 0.0001;
    vec3 specular = numerator / denominator;
    
    vec3 kS = F;
    vec3 kD = (vec3(1.0) - kS) * (1.0 - metallic);
    
    float NdotL = max(dot(N, L), 0.0);
    vec3 Lo = (kD * albedo.rgb / 3.14159265 + specular) * vec3(3.0) * NdotL;
    
    // Ambient
    vec3 ambient = vec3(0.03) * albedo.rgb;
    vec3 color = ambient + Lo;
    
    // Tone mapping (Reinhard)
    color = color / (color + vec3(1.0));
    
    // Gamma correction
    color = pow(color, vec3(1.0/2.2));
    
    imageStore(outputImage, pixelCoord, vec4(color, 1.0));
}
